{
  "manifest_version": 3,
  "name": "Flashcard Midterm Extension",
  "version": "1.0",
  "description": "Highlight text to create flashcards and use hand gestures to review.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
    
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ]
  
}
